<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>img\favicon\favicon.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefaultItemExcludes>$(DefaultItemExcludes);PlmXmlSyntax.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_DevHelp\PlmXml.cs" />
    <Compile Remove="_DevHelp\PlmXmlGenerator.cs" />
    <Compile Remove="_DevHelp\PlmXmlParser.cs" />
    <Compile Remove="_DevHelp\PlmXmlParserFactory.cs" />
    <Compile Remove="_DevHelp\plmxml_parse_gen.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="img\favicon\favicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0 " />
  </ItemGroup>

  <ItemGroup>
    <None Include="img\favicon\favicon-16x16.png" />
    <None Include="img\favicon\favicon-32x32.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="_DevHelp\PlmXml.cs" />
    <None Include="_DevHelp\PlmXmlGenerator.cs" />
    <None Include="_DevHelp\PlmXmlParser.cs" />
    <None Include="_DevHelp\PlmXmlParserFactory.cs" />
    <None Include="_DevHelp\plmxml_parse_gen.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="img\favicon\favicon-16x16.png" />
    <Resource Include="img\favicon\favicon-32x32.png" />
  </ItemGroup>

</Project>
