<Page
  x:Class="PlmXmlSyntax.Views.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:PlmXmlSyntax.Helpers"
  xmlns:local="clr-namespace:PlmXmlSyntax.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="SettingsPage"
  d:DataContext="{d:DesignInstance local:SettingsPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="650"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
  </Page.Resources>

  <ScrollViewer>
    <StackPanel Margin="12">
        <TextBlock FontSize="20" FontWeight="Bold" Text="Configuration &amp; Profiles" Margin="0,0,0,12" />

        <!-- Profile Selection -->
        <ui:CardControl Header="Active Parsing Profile" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding ViewModel.Profiles}"
                          SelectedItem="{Binding ViewModel.SelectedProfile}"
                          DisplayMemberPath="Name"
                          Width="250" Margin="0,0,8,0"/>
                <ui:Button Content="Save Changes"
                           Command="{Binding ViewModel.SaveProfileCommand}"
                           Appearance="Primary" Padding="8,4" />
            </StackPanel>
        </ui:CardControl>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Merge Engine Options" Margin="0,8,0,6" />
        <ui:Card Margin="0,0,0,8">
            <StackPanel Margin="10">
                <TextBlock Text="Merge Strategy" Margin="0,0,0,4" FontWeight="Medium" />
                <ComboBox ItemsSource="{Binding ViewModel.MergeStrategies}"
                          SelectedItem="{Binding ViewModel.SelectedProfile.ActiveMergeStrategy}"
                          HorizontalAlignment="Left" Width="250" Margin="0,0,0,8" />

                <TextBlock Text="File Prefix Pattern" Margin="0,0,0,4" FontWeight="Medium" />
                <ui:TextBox Text="{Binding ViewModel.SelectedProfile.MergePrefixPattern}"
                            PlaceholderText="F{0}_" Width="250" HorizontalAlignment="Left" Margin="0,0,0,4" />
                <TextBlock Text="Use {0} for file index (e.g. F1_id1)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Parser Intelligence" Margin="0,8,0,6" />
        <ui:Card Margin="0,0,0,8">
            <StackPanel Margin="10">
                <TextBlock Text="Root Search Heuristic" Margin="0,0,0,4" FontWeight="Medium" />
                <ComboBox ItemsSource="{Binding ViewModel.RootSearchStrategies}"
                          SelectedItem="{Binding ViewModel.SelectedProfile.RootStrategy}"
                          HorizontalAlignment="Left" Width="250" Margin="0,0,0,8" />

                <TextBlock Text="Part Number Source (UserData Title)" Margin="0,0,0,4" FontWeight="Medium" />
                <ui:TextBox Text="{Binding ViewModel.SelectedProfile.PartNumberUserDataTitle}"
                            PlaceholderText="Mehrnummern" Width="250" HorizontalAlignment="Left" />
            </StackPanel>
        </ui:Card>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Guard &amp; IP Protection" Margin="0,8,0,6" />
        <ui:Card Margin="0,0,0,12">
            <StackPanel Margin="10">
                <CheckBox Content="Scrub Usernames from Metadata"
                          IsChecked="{Binding ViewModel.SelectedProfile.ScrubUserNames}" Margin="0,0,0,6" />
                <CheckBox Content="Hide Cost Attributes"
                          IsChecked="{Binding ViewModel.SelectedProfile.ScrubCosts}" />
            </StackPanel>
        </ui:Card>

        <Separator Margin="0,0,0,12" />

        <TextBlock FontSize="16" FontWeight="Medium" Text="Personalization" />
        <TextBlock Margin="0,6,0,4" Text="Theme" />
        <RadioButton
          Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
          CommandParameter="theme_light"
          Content="Light"
          GroupName="themeSelect"
          IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}"
        />
        <RadioButton
          Margin="0,4,0,0"
          Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
          CommandParameter="theme_dark"
          Content="Dark"
          GroupName="themeSelect"
          IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}"
        />

        <TextBlock Margin="0,12,0,4" FontSize="16" FontWeight="Medium" Text="About PlmXmlSyntax" />
        <TextBlock Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
    </StackPanel>
  </ScrollViewer>
</Page>
