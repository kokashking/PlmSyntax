<Page
  x:Class="PlmXmlSyntax.Views.Pages.ImporterPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:PlmXmlSyntax.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="ImporterPage"
  d:DataContext="{d:DesignInstance local:ImporterPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:Button
      Grid.Row="0"
      Command="{Binding ViewModel.ImportFileCommand, Mode=OneWay}"
      Content="Import PLMXML"
      Icon="ArrowImport24"
      HorizontalAlignment="Center"
      Margin="0,0,0,20"
    />

    <TextBlock
      Grid.Row="1"
      Text="{Binding ViewModel.FilePath, Mode=OneWay}"
      HorizontalAlignment="Center"
      Margin="0,0,0,10"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
    />

    <TextBlock
        Grid.Row="2"
        Text="{Binding ViewModel.Status, Mode=OneWay}"
        HorizontalAlignment="Center"
        FontWeight="SemiBold"
    />
    
    <ProgressBar 
        Grid.Row="3"
        IsIndeterminate="True" 
        Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
        Width="200"
        Height="5"
        Margin="0,20,0,0"
    />
  </Grid>
</Page>