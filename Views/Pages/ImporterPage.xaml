<Page
  x:Class="PlmXmlSyntax.Views.Pages.ImporterPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:PlmXmlSyntax.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:models="clr-namespace:PlmXmlSyntax.Models"
  Title="ImporterPage"
  d:DataContext="{d:DesignInstance local:ImporterPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.VerticalScrollBarVisibility="Disabled"
  mc:Ignorable="d"
>
  <Page.Resources>
    <local:PathToFileNameConverter x:Key="PathToFileNameConverter"/>
  </Page.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /> <!-- Toolbar & Staging -->
      <RowDefinition Height="Auto" /> <!-- Status -->
      <RowDefinition Height="*" />    <!-- Main Results -->
    </Grid.RowDefinitions>

    <!-- Header / Staging Area (Minimizable) -->
    <Expander Header="PLMXML Staging Area" Grid.Row="0" Margin="0,0,0,12" IsExpanded="True">
        <StackPanel Margin="8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:Button
                    Command="{Binding ViewModel.AddFilesCommand, Mode=OneWay}"
                    Content="Add Files"
                    Icon="Add24"
                    Margin="0,0,8,0"
                />
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding ViewModel.StartImportCommand, Mode=OneWay}"
                    Content="Start Process"
                    Icon="Play24"
                    Margin="0,0,8,0"
                />
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding ViewModel.ClearFilesCommand, Mode=OneWay}"
                    Content="Clear All"
                    Icon="Delete24"
                />
            </StackPanel>

            <ui:ListView ItemsSource="{Binding ViewModel.StagedFiles}" BorderThickness="0" Background="Transparent" MaxHeight="200">
                <ui:ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ImportedFileInfo}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" ToolTip="{Binding FullPath}" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0" />
                            <ui:Button 
                                Grid.Column="2" 
                                Padding="2"
                                MinHeight="24"
                                MinWidth="24"
                                Appearance="Transparent" 
                                Command="{Binding DataContext.ViewModel.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                            >
                                <ui:SymbolIcon Symbol="Dismiss16" Foreground="Red" />
                            </ui:Button>
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>
        </StackPanel>
    </Expander>

    <!-- Status Bar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock
            Text="{Binding ViewModel.Status, Mode=OneWay}"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
        />
        <ProgressBar
            IsIndeterminate="True"
            Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
            Width="120"
            Height="4"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
        />
    </StackPanel>

    <!-- Main Results List -->
    <ui:ListView
        Grid.Row="2"
        x:Name="LeafNodesList"
        ItemsSource="{Binding ViewModel.LeafNodes, Mode=OneWay}"
        PreviewMouseWheel="ListView_PreviewMouseWheel"
        ButtonBase.Click="OnColumnHeaderClick"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling"
        VirtualizingPanel.ScrollUnit="Item"
        ScrollViewer.CanContentScroll="True"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        SelectionMode="Extended"
        BorderThickness="1"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
    >
        <ui:ListView.Resources>
            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </ui:ListView.Resources>
        <ui:ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <GridViewRowPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:ListView.ItemContainerStyle>
        <ui:ListView.View>
            <GridView>
                <GridViewColumn Header="Status" Width="60">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <ui:SymbolIcon x:Name="StatusIcon" Symbol="CheckmarkCircle24" Foreground="Green" VerticalAlignment="Center" ToolTip="{Binding StatusMessage}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="Warning24" />
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="Orange" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="ErrorCircle24" />
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Source" Width="150">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SourcePlmXmlPath, Converter={StaticResource PathToFileNameConverter}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" ToolTip="{Binding SourcePlmXmlPath}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Name" Width="150">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="File" Width="250">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Format" Width="60">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Format}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="ID" Width="80">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProductRevisionViewId}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Part Numbers" Width="200">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PartNumbers}" Foreground="{DynamicResource SystemAccentColorLight2Brush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ui:ListView.View>
    </ui:ListView>
  </Grid>
</Page>
