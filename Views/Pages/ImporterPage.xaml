<Page
  x:Class="PlmXmlSyntax.Views.Pages.ImporterPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:PlmXmlSyntax.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="ImporterPage"
  d:DataContext="{d:DesignInstance local:ImporterPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <!-- Removed ListToStringConverter as we now store as string -->
  </Page.Resources>

  <DockPanel Margin="16">

    <ui:Button
      DockPanel.Dock="Top"
      Command="{Binding ViewModel.ImportFileCommand, Mode=OneWay}"
      Content="Import PLMXML"
      Icon="ArrowImport24"
      HorizontalAlignment="Left"
      Margin="0,0,0,12"
    />

    <TextBlock
      DockPanel.Dock="Top"
      Text="{Binding ViewModel.FilePath, Mode=OneWay}"
      HorizontalAlignment="Left"
      Margin="0,0,0,8"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      TextTrimming="CharacterEllipsis"
    />

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock
            Text="{Binding ViewModel.Status, Mode=OneWay}"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
        />
        <ProgressBar
            IsIndeterminate="True"
            Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
            Width="120"
            Height="4"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
        />
    </StackPanel>

    <Separator DockPanel.Dock="Top" Margin="0,4,0,12"/>

    <!-- ListView with GridView for reliable virtualization -->
    <ListView
        ItemsSource="{Binding ViewModel.LeafNodes, Mode=OneWay}"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling"
        ScrollViewer.CanContentScroll="True"
        ScrollViewer.IsDeferredScrollingEnabled="True"
        BorderThickness="0"
        Background="Transparent"
        SelectionMode="Extended"
    >
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,1">
                                <GridViewRowPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
            <GridView>
                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                <GridViewColumn Header="File" DisplayMemberBinding="{Binding FileName}" Width="280"/>
                <GridViewColumn Header="Format" DisplayMemberBinding="{Binding Format}" Width="70"/>
                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ProductRevisionViewId}" Width="80"/>
                <GridViewColumn Header="Part Numbers" DisplayMemberBinding="{Binding PartNumbers}" Width="200"/>
            </GridView>
        </ListView.View>
    </ListView>

  </DockPanel>
</Page>
