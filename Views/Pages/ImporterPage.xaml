<Page
  x:Class="PlmXmlSyntax.Views.Pages.ImporterPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:PlmXmlSyntax.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:models="clr-namespace:PlmXmlSyntax.Models"
  Title="ImporterPage"
  d:DataContext="{d:DesignInstance local:ImporterPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.VerticalScrollBarVisibility="Disabled"
  mc:Ignorable="d"
>
  <Page.Resources>
    <local:PathToFileNameConverter x:Key="PathToFileNameConverter"/>
  </Page.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /> <!-- Toolbar & Staging -->
      <RowDefinition Height="Auto" /> <!-- Status -->
      <RowDefinition Height="*" />    <!-- Main Results -->
    </Grid.RowDefinitions>

    <!-- Header / Staging Area (Minimizable) -->
    <Expander Header="PLMXML Staging Area" Grid.Row="0" Margin="0,0,0,6" IsExpanded="True" Padding="4" Grid.IsSharedSizeScope="True">
        <StackPanel Margin="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:Button
                    Command="{Binding ViewModel.AddFilesCommand, Mode=OneWay}"
                    Content="Add Files"
                    Padding="8,2"
                    Margin="0,0,4,0"
                >
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add20" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button
                    Appearance="Primary"
                    Command="{Binding ViewModel.StartImportCommand, Mode=OneWay}"
                    Content="Start Process"
                    Padding="8,2"
                    Margin="0,0,4,0"
                >
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Play20" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button
                    Appearance="Primary"
                    Command="{Binding ViewModel.MergeFilesCommand, Mode=OneWay}"
                    Content="Merge Files"
                    Padding="8,2"
                    Margin="0,0,4,0"
                >
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowRouting20" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding ViewModel.ClearFilesCommand, Mode=OneWay}"
                    Content="Clear All"
                    Padding="8,2"
                >
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Delete20" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <ui:ListView ItemsSource="{Binding ViewModel.StagedFiles}" BorderThickness="0" Background="Transparent" MaxHeight="120" Padding="0,0,16,0">
                <ui:ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ImportedFileInfo}">
                        <Grid HorizontalAlignment="Stretch" Margin="0,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StatusCol" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ActionCol" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontSize="12" ToolTip="{Binding FullPath}" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0" />
                            <ui:Button 
                                Grid.Column="2" 
                                Padding="1"
                                MinHeight="18"
                                MinWidth="18"
                                Appearance="Transparent" 
                                Command="{Binding DataContext.ViewModel.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                            >
                                <ui:SymbolIcon Symbol="Dismiss12" Foreground="Red" />
                            </ui:Button>
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="20" />
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
            </ui:ListView>
        </StackPanel>
    </Expander>

    <!-- Status Bar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock
            Text="{Binding ViewModel.Status, Mode=OneWay}"
            FontWeight="SemiBold"
            FontSize="12"
            VerticalAlignment="Center"
        />
        <ProgressBar
            IsIndeterminate="{Binding ViewModel.IsBusy}"
            Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
            Width="100"
            Height="3"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
        />
    </StackPanel>

    <!-- Main Results List -->
    <ui:ListView
        Grid.Row="2"
        x:Name="LeafNodesList"
        ItemsSource="{Binding ViewModel.LeafNodes, Mode=OneWay}"
        PreviewMouseWheel="ListView_PreviewMouseWheel"
        ButtonBase.Click="OnColumnHeaderClick"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling"
        VirtualizingPanel.ScrollUnit="Item"
        ScrollViewer.CanContentScroll="True"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        SelectionMode="Extended"
        BorderThickness="1"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
    >
        <ui:ListView.Resources>
            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </ui:ListView.Resources>
        <ui:ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="Margin" Value="0,0" />
                <Setter Property="Padding" Value="4,1" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True">
                                <GridViewRowPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:ListView.ItemContainerStyle>
        <ui:ListView.View>
            <GridView>
                <GridViewColumn Header="Status" Width="40">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <ui:SymbolIcon x:Name="StatusIcon" Symbol="CheckmarkCircle20" Foreground="Green" VerticalAlignment="Center" ToolTip="{Binding StatusMessage}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="Warning20" />
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="Orange" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="ErrorCircle20" />
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Source" Width="120">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SourcePlmXmlPath, Converter={StaticResource PathToFileNameConverter}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" ToolTip="{Binding SourcePlmXmlPath}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Name" Width="150">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="File" Width="200">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Format" Width="50">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Format}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="ID" Width="70">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProductRevisionViewId}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Part Numbers" Width="150">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PartNumbers}" FontSize="11" Foreground="{DynamicResource SystemAccentColorLight2Brush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ui:ListView.View>
    </ui:ListView>
  </Grid>
</Page>
