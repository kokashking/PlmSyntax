<Page
  x:Class="PlmXmlSyntax.Views.Pages.ImporterPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:PlmXmlSyntax.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="ImporterPage"
  d:DataContext="{d:DesignInstance local:ImporterPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ScrollViewer.VerticalScrollBarVisibility="Disabled"
  mc:Ignorable="d"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header Area: Sticky -->
    <StackPanel Grid.Row="0" Background="{DynamicResource ApplicationBackgroundBrush}">
        <ui:Button
          Command="{Binding ViewModel.ImportFileCommand, Mode=OneWay}"
          Content="Import PLMXML"
          Icon="ArrowImport24"
          HorizontalAlignment="Left"
          Margin="0,0,0,12"
        />

        <TextBlock
          Text="{Binding ViewModel.FilePath, Mode=OneWay}"
          HorizontalAlignment="Left"
          Margin="0,0,0,8"
          TextTrimming="CharacterEllipsis"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock
                Text="{Binding ViewModel.Status, Mode=OneWay}"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
            />
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Width="120"
                Height="4"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
            />
        </StackPanel>
        <Separator Margin="0,4,0,12"/>
    </StackPanel>

    <!-- List Area: Scrollable with WPF-UI styling -->
    <ui:ListView
        Grid.Row="1"
        x:Name="LeafNodesList"
        ItemsSource="{Binding ViewModel.LeafNodes, Mode=OneWay}"
        PreviewMouseWheel="ListView_PreviewMouseWheel"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling"
        VirtualizingPanel.ScrollUnit="Item"
        ScrollViewer.CanContentScroll="True"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        SelectionMode="Extended"
        BorderThickness="0"
    >
        <ui:ListView.Resources>
            <!-- Style for GridView headers to make them darker and integrated -->
            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </ui:ListView.Resources>
        <ui:ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <GridViewRowPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:ListView.ItemContainerStyle>
        <ui:ListView.View>
            <GridView>
                <GridViewColumn Header="Name" Width="150">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="File" Width="250">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Format" Width="60">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Format}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="ID" Width="80">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProductRevisionViewId}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Part Numbers" Width="200">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PartNumbers}" Foreground="{DynamicResource SystemAccentColorLight2Brush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ui:ListView.View>
    </ui:ListView>
  </Grid>
</Page>
