<?xml version="1.0" encoding="utf-8"?>
<!-- Standard 2-level assembly: root -> child -> leaf with geometry -->
<PLMXML xmlns="http://www.plmxml.org/Schemas/PLMXMLSchema" author="TestExporter">
  <ProductDef>
    <InstanceGraph rootInstanceRef="#rootInst">
      <ProductInstance id="rootInst" name="Root_Assembly" partRef="#rootView" />
      <ProductInstance id="childInst" name="Child_Part"   partRef="#partView" />
      <ProductRevisionView id="rootView" name="Root_Assembly" type="assembly" instanceRefs="#childInst" />
      <ProductRevisionView id="partView" name="Geometry_A" type="part">
        <Representation id="rep1" format="JT" location="part_a.jt" />
      </ProductRevisionView>
    </InstanceGraph>
  </ProductDef>
</PLMXML>
