<?xml version="1.0" encoding="utf-8"?>
<!-- Indirect link: ProductInstance -> ProductRevision -> ProductRevisionView -->
<PLMXML xmlns="http://www.plmxml.org/Schemas/PLMXMLSchema" author="TestExporter">
  <ProductRevision id="rev1" name="Rev1" instanceRefs="#view1" />
  <ProductDef>
    <InstanceGraph rootInstanceRef="#rootInst">
      <ProductInstance id="rootInst" name="Root_Assembly" partRef="#rootView" />
      <ProductInstance id="childInst" name="Child_Part"   partRef="#rev1" />
      <ProductRevisionView id="rootView" name="Root_Assembly" type="assembly" instanceRefs="#childInst" />
      <ProductRevisionView id="view1"   name="Final_View"    type="part">
        <Representation id="rep1" format="JT" location="part.jt" />
      </ProductRevisionView>
    </InstanceGraph>
  </ProductDef>
</PLMXML>
